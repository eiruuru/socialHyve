VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Meta (Facebook / Instagram) — used in Edge Functions
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-project.supabase.co/functions/v1/meta-oauth-callback

# Canva Connect — used in Edge Functions
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://your-project.supabase.co/functions/v1/canva-oauth-callback

# App URL (for OAuth state redirects back to frontend)
APP_URL=http://localhost:5173

# Token encryption key (32+ chars) for storing OAuth tokens
TOKEN_ENCRYPTION_KEY=
