# Frontend (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Web Push VAPID public key (optional — browser push notifications)
VITE_VAPID_PUBLIC_KEY=

# Supabase CLI (optional — or run `npx supabase login`)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Service role key — for cron setup only (npm run setup:cron). Never use in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook / Instagram) — Edge Function secrets
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/meta-oauth-callback
# Facebook Login for Business configuration ID (from Meta App Dashboard → Facebook Login for Business)
META_CONFIG_ID=

# Canva Connect — Edge Function secrets
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/canva-oauth-callback

# App URL (OAuth redirects back to frontend after connect)
# Dev: http://localhost:5173 — Production: https://socialhyve.app
APP_URL=http://localhost:5173

# Optional: Resend for invite emails (Edge Function send-invite-email)
RESEND_API_KEY=
INVITE_FROM_EMAIL=onboarding@resend.dev

# Optional: OpenAI for AI Caption in post composer (Edge Function generate-caption)
OPENAI_API_KEY=

# Optional: AES-GCM encryption for OAuth tokens at rest (Edge Function secret)
TOKEN_ENCRYPTION_KEY=

# Optional: shared secret for pg_cron → Edge Function calls (also stored in Vault for cron jobs)
CRON_SECRET=
